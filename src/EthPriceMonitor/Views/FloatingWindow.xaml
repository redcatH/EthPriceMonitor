<Window x:Class="EthPriceMonitor.Views.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EthPriceMonitor.ViewModels"
        xmlns:converters="clr-namespace:EthPriceMonitor.Converters"
        xmlns:services="clr-namespace:EthPriceMonitor.Services"
        Title="ETH Price Monitor"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ResizeMode="NoResize"
        Width="280" Height="160"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <converters:PriceColorConverter x:Key="PriceColorConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <!-- Connection status dot: Connected=green, else=gray -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="#6B7280" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ConnectionStatus}" Value="{x:Static services:ConnectionState.Connected}">
                    <Setter Property="Fill" Value="#16C784" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="#F3F3F3"
            CornerRadius="8"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            Padding="16,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.15" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top row: Symbol + Connection status -->
            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="ETH/USDT"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#374151"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center" />
                <Ellipse Style="{StaticResource StatusDot}"
                         DockPanel.Dock="Right"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center" />
            </DockPanel>

            <!-- Middle: Large price display -->
            <TextBlock Grid.Row="1"
                       Text="{Binding CurrentPrice}"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{Binding IsPriceUp, Converter={StaticResource PriceColorConverter}}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left" />

            <!-- Bottom row: Change % + High/Low -->
            <DockPanel Grid.Row="2" Margin="0,8,0,0">
                <TextBlock Text="{Binding PriceChangePercent}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{Binding IsPriceUp, Converter={StaticResource PriceColorConverter}}"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock FontSize="11" Foreground="#6B7280">
                        <Run Text="H:" />
                        <Run Text="{Binding HighPrice, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock FontSize="11" Foreground="#6B7280" Margin="8,0,0,0">
                        <Run Text="L:" />
                        <Run Text="{Binding LowPrice, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
