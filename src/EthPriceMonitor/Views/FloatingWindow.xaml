<Window x:Class="EthPriceMonitor.Views.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EthPriceMonitor.ViewModels"
        xmlns:converters="clr-namespace:EthPriceMonitor.Converters"
        xmlns:services="clr-namespace:EthPriceMonitor.Services"
        Title="ETH Price Monitor"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="{Binding WindowTopmost}"
        Opacity="{Binding WindowOpacity}"
        ResizeMode="NoResize"
        Width="280" Height="160"
        ShowInTaskbar="False">

    <Window.Resources>
        <converters:PriceColorConverter x:Key="PriceColorConverter" />
        <converters:PinToolTipConverter x:Key="PinToolTipConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <!-- Connection status dot: Connected=green, else=gray -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="#6B7280" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ConnectionStatus}" Value="{x:Static services:ConnectionState.Connected}">
                    <Setter Property="Fill" Value="#16C784" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource CardBackgroundBrush}"
            CornerRadius="8"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Padding="16,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.15" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top row: Symbol + Pin button + Connection status -->
            <DockPanel Grid.Row="0" Margin="0,0,0,8"
                       MouseLeftButtonDown="Window_MouseLeftButtonDown"
                       Cursor="SizeAll">
<TextBlock Text="ETH/USDT"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource ForegroundBrush}"
                            DockPanel.Dock="Left"
                            VerticalAlignment="Center" />

                <!-- Pin/Unpin toggle button -->
                <Button DockPanel.Dock="Right"
                        Command="{Binding ToggleClickThroughCommand}"
                        Width="20" Height="20"
                        Margin="6,0,0,0"
                        Cursor="Hand"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="{Binding IsClickThrough, Converter={StaticResource PinToolTipConverter}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <!-- Pin icon: uses Unicode pushpin characters -->
                    <TextBlock FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#x1F4CC;" />
                                <Setter Property="Foreground" Value="#9CA3AF" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsClickThrough}" Value="True">
                                        <Setter Property="Text" Value="&#x1F4CC;" />
                                        <Setter Property="Foreground" Value="#3B82F6" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

                <Ellipse Style="{StaticResource StatusDot}"
                         DockPanel.Dock="Right"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center" />
            </DockPanel>

            <!-- Middle: Large price display -->
            <TextBlock Grid.Row="1"
                       Text="{Binding CurrentPrice}"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{Binding IsPriceUp, Converter={StaticResource PriceColorConverter}}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left" />

            <!-- Bottom row: Change % + High/Low -->
            <DockPanel Grid.Row="2" Margin="0,8,0,0">
                <TextBlock Text="{Binding PriceChangePercent}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{Binding IsPriceUp, Converter={StaticResource PriceColorConverter}}"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock FontSize="11" Foreground="{DynamicResource StatusDisconnectedBrush}">
                        <Run Text="H:" />
                        <Run Text="{Binding HighPrice, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock FontSize="11" Foreground="{DynamicResource StatusDisconnectedBrush}" Margin="8,0,0,0">
                        <Run Text="L:" />
                        <Run Text="{Binding LowPrice, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
