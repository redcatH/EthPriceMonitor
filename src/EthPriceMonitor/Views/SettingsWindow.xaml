<Window x:Class="EthPriceMonitor.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EthPriceMonitor.ViewModels"
        xmlns:models="clr-namespace:EthPriceMonitor.Models"
        xmlns:converters="clr-namespace:EthPriceMonitor.Converters"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="ETH Price Monitor 设置"
        Width="400" Height="500"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        MinWidth="350" MinHeight="400">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <ObjectDataProvider x:Key="AlertDirections"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:AlertDirection" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 报警阈值区域 -->
        <TextBlock Grid.Row="0"
                   Text="报警阈值"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource ForegroundBrush}"
                   Margin="0,0,0,8" />

        <!-- Thresholds ListView -->
        <ListView Grid.Row="1"
                  ItemsSource="{Binding AlertThresholds}"
                  SelectedItem="{Binding SelectedThreshold}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  Margin="0,0,0,8"
                  x:Name="ThresholdsList">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="价格" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                                         Width="80" HorizontalAlignment="Left" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="方向" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding Source={StaticResource AlertDirections}}"
                                          SelectedValue="{Binding Direction}"
                                          Width="60" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="启用" Width="60">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsEnabled}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="标签" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                         Width="100" HorizontalAlignment="Left" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Threshold action buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="添加"
                    Command="{Binding AddThresholdCommand}"
                    Padding="12,6"
                    Margin="0,0,8,0"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="White" />
            <Button Content="删除"
                    Command="{Binding RemoveThresholdCommand}"
                    Padding="12,6"
                    Background="#E0E0E0"
                    Foreground="{DynamicResource ForegroundBrush}" />
        </StackPanel>

        <!-- 通用设置区域 -->
        <TextBlock Grid.Row="3"
                   Text="通用设置"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource ForegroundBrush}"
                   Margin="0,0,0,8" />

        <StackPanel Grid.Row="3" Margin="0,28,0,16">
            <CheckBox Content="开机自启"
                      IsChecked="{Binding AutoStartWithWindows}"
                      Foreground="{DynamicResource ForegroundBrush}"
                      Margin="0,0,0,8" />
            <CheckBox Content="显示悬浮窗"
                      IsChecked="{Binding ShowFloatingWindow}"
                      Foreground="{DynamicResource ForegroundBrush}"
                      Margin="0,0,0,8" />
            <CheckBox Content="窗口置顶"
                      IsChecked="{Binding WindowTopmost}"
                      Foreground="{DynamicResource ForegroundBrush}"
                      Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="透明度"
                           Foreground="{DynamicResource ForegroundBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <Slider Value="{Binding WindowOpacity}"
                        Minimum="0.2" Maximum="1.0"
                        Width="150"
                        VerticalAlignment="Center"
                        TickFrequency="0.1"
                        IsSnapToTickEnabled="True" />
                <TextBlock Text="{Binding WindowOpacity, StringFormat='{}{0:P0}'}"
                           Foreground="{DynamicResource ForegroundBrush}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- 按钮区域 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="保存"
                    Click="SaveButton_Click"
                    Padding="16,8"
                    Margin="0,0,8,0"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="White" />
            <Button Content="取消"
                    Click="CancelButton_Click"
                    Padding="16,8"
                    Background="#E0E0E0"
                    Foreground="{DynamicResource ForegroundBrush}" />
        </StackPanel>
    </Grid>
</Window>