<Window x:Class="EthPriceMonitor.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EthPriceMonitor.ViewModels"
        xmlns:converters="clr-namespace:EthPriceMonitor.Converters"
        Title="ETH Price Monitor 设置"
        Width="400" Height="500"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        MinWidth="350" MinHeight="400">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 报警阈值区域 -->
        <TextBlock Grid.Row="0"
                   Text="报警阈值"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource ForegroundBrush}"
                   Margin="0,0,0,8" />

        <!-- Thresholds ListView -->
        <ListView Grid.Row="1"
                  ItemsSource="{Binding AlertThresholds}"
                  SelectedItem="{Binding SelectedThreshold}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  Margin="0,0,0,8"
                  x:Name="ThresholdsList">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="价格" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Price, StringFormat='${0:F2}'}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="方向" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Direction}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="启用" Width="60">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsEnabled}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="标签" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Threshold action buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="添加"
                    Command="{Binding AddThresholdCommand}"
                    Padding="12,6"
                    Margin="0,0,8,0"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="White" />
            <Button Content="删除"
                    Command="{Binding RemoveThresholdCommand}"
                    Padding="12,6"
                    Background="#E0E0E0"
                    Foreground="{DynamicResource ForegroundBrush}" />
        </StackPanel>

        <!-- 通用设置区域 -->
        <TextBlock Grid.Row="3"
                   Text="通用设置"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource ForegroundBrush}"
                   Margin="0,0,0,8" />

        <StackPanel Grid.Row="3" Margin="0,28,0,16">
            <CheckBox Content="开机自启"
                      IsChecked="{Binding AutoStartWithWindows}"
                      Foreground="{DynamicResource ForegroundBrush}"
                      Margin="0,0,0,8" />
            <CheckBox Content="显示悬浮窗"
                      IsChecked="{Binding ShowFloatingWindow}"
                      Foreground="{DynamicResource ForegroundBrush}" />
        </StackPanel>

        <!-- 按钮区域 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="保存"
                    Command="{Binding SaveCommand}"
                    Padding="16,8"
                    Margin="0,0,8,0"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="White" />
            <Button Content="取消"
                    Padding="16,8"
                    Background="#E0E0E0"
                    Foreground="{DynamicResource ForegroundBrush}" />
        </StackPanel>
    </Grid>
</Window>