<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:tb="http://www.hardcodet.net/taskbar"
                    xmlns:vm="clr-namespace:EthPriceMonitor.ViewModels">

    <vm:TrayIconViewModel x:Key="TrayIconViewModel" />

    <ContextMenu x:Key="TrayContextMenu">
        <MenuItem Header="显示/隐藏悬浮窗"
                  Command="{Binding ToggleFloatingWindowCommand}"
                  CommandParameter="{Binding}" />
        <MenuItem Header="设置..."
                  Command="{Binding OpenSettingsCommand}" />
        <Separator />
        <MenuItem Header="退出"
                  Command="{Binding ExitApplicationCommand}" />
    </ContextMenu>

    <tb:TaskbarIcon x:Key="TrayIcon"
                    IconSource="/Assets/eth.ico"
                    ToolTipText="ETH Price Monitor"
                    ContextMenu="{StaticResource TrayContextMenu}"
                    DataContext="{StaticResource TrayIconViewModel}"
                    DoubleClickCommand="{Binding ToggleFloatingWindowCommand}" />

</ResourceDictionary>
