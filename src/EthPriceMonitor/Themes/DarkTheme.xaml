<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BackgroundColor">#1C1C1E</Color>
    <Color x:Key="ForegroundColor">#FFFFFF</Color>
    <Color x:Key="CardBackgroundColor">#2C2C2E</Color>
    <Color x:Key="BorderColor">#3A3A3C</Color>
    <Color x:Key="AccentColor">#0A84FF</Color>
    <Color x:Key="PriceUpColor">#16C784</Color>
    <Color x:Key="PriceDownColor">#EA3943</Color>
    <Color x:Key="StatusConnectedColor">#16C784</Color>
    <Color x:Key="StatusDisconnectedColor">#636366</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="PriceUpBrush" Color="{StaticResource PriceUpColor}" />
    <SolidColorBrush x:Key="PriceDownBrush" Color="{StaticResource PriceDownColor}" />
    <SolidColorBrush x:Key="StatusConnectedBrush" Color="{StaticResource StatusConnectedColor}" />
    <SolidColorBrush x:Key="StatusDisconnectedBrush" Color="{StaticResource StatusDisconnectedColor}" />
</ResourceDictionary>
